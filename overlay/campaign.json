  "_comment": "Every campaign rule below is gated on the Bork'an detachment (c4a1-5eed-0000-0030) being selected in the force.",

  "detachment": {
    "name": "Bork’an",
    "id": "c4a1-5eed-0000-0030",
    "import": true,
    "type": "upgrade",
    "hidden": false,
    "constraints": [
      { "id": "c4a1-5eed-0000-0031", "field": "selections", "includeChildSelections": false, "scope": "parent", "shared": true, "type": "max", "value": 1 }
    ],
    "costs": [
      { "name": "pts", "typeId": "51b2-306e-1021-d207", "value": 0 },
      { "name": "Detachment Points", "typeId": "82ae-1066-5107-6ae0", "value": 0 }
    ],
    "modifiers": [
      {
        "comment": "Sept Tenet: +4\" Range on every ranged weapon in the army, applied once (same roster-wide pattern as Astra Militarum's Morale options)",
        "affects": "self.entries.forces.recursive.profiles.Ranged Weapons", "scope": "roster",
        "field": "annotation", "join": ", ", "skipIfPresent": "Sept Tenet", "type": "append", "value": "Sept Tenet"
      },
      {
        "affects": "self.entries.forces.recursive.profiles.Ranged Weapons", "scope": "roster",
        "field": "9896-9419-16a1-92fc", "type": "increment", "value": 4
      },
      {
        "comment": "Hidden in Boarding Actions, like the official detachments",
        "field": "hidden", "type": "set", "value": true,
        "conditions": [
          { "childId": "1d6e-2579-8e7f-1ed4", "field": "selections", "includeChildSelections": true, "scope": "force", "shared": true, "type": "instanceOf", "value": 1 }
        ]
      }
    ],
    "rules": [
      {
        "name": "Sept Tenet: Superior Craftsmanship",
        "id": "c4a1-5eed-0000-0001",
        "hidden": false,
        "description": "*The cadres of Bork’an Sept epitomise the T’au application of technological supremacy as the solution to every challenge. The fearless progressives of their Earth Caste experiment and refine constantly to ensure that, when the armies of Bork’an march to war, they are armed and armoured with the highest specification wargear in the T’au Empire.*\n\n*From Bork’an Sept’s renowned applied science divisions come the most advanced and ingenious weapon prototypes, and the finest suits of combat armour, field tested by elite contingents of Fire Caste soldiers.*\n\n- Add 4\" to the Range characteristic of ranged weapons that models with this tenet are equipped with.\n- Each time a ranged attack is made with a weapon that has a Strength characteristic greater than the Toughness characteristic of a **VEHICLE** or **BATTLESUIT** unit with this tenet, subtract 2 from the Strength characteristic of that attack."
      }
    ]
  },

